APP_NAME="Lic. Erika Magaña Psicóloga"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://psicologia.test

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# --- Datos del sitio (editables sin tocar código, o desde /admin) ---
SITE_NAME="Lic. Erika Magaña"
SITE_REGISTRATION="Colegiada J.V.P.P. 4615"
SITE_WHATSAPP=50360606225
SITE_WHATSAPP_SHOW="+503 6060 6225"
SITE_EMAIL="contacto@ejemplo.com"
SITE_DEMO_MODE=false

# --- Cuenta de administración del panel /admin ---
# No pongas aquí una contraseña real. Crea la cuenta con:
#   php artisan make:admin
# (te la pide de forma interactiva). Estas variables son opcionales, solo
# útiles para scripts de despliegue no interactivos.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Login social (Socialite) — inactivo hasta configurar credenciales reales.
# Además, cada proveedor debe activarse desde /admin/security una vez que
# existan estas variables. Crea la app OAuth en la consola de cada proveedor
# y pega aquí su Client ID/Secret. ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

# --- Códigos 2FA por SMS/WhatsApp (Twilio) — inactivo hasta configurar
# credenciales reales. También debe activarse desde /admin/security. ---
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
# TWILIO_WHATSAPP_FROM=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=psicologia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local: MAIL_MAILER=log escribe los correos en storage/logs/laravel.log
# Con Mailpit (Laragon): MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@psicologia.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
